# Uncomment this line to define a global platform for your project
platform :ios, '15.6'

require 'fileutils'

# flutter_llama on pub.dev ships static libs but omits llama.cpp headers.
# Copy them from the bundled xcframework before Xcode compiles the plugin.
def patch_flutter_llama_headers!
  plugin_root = File.expand_path(File.join('.symlinks', 'plugins', 'flutter_llama'), __dir__)
  plugin_ios = File.join(plugin_root, 'ios')
  return unless File.directory?(plugin_ios)

  headers_src = File.join(
    plugin_ios,
    'llama.xcframework',
    'ios-arm64_x86_64-simulator',
    'llama.framework',
    'Headers'
  )
  unless File.directory?(headers_src)
    headers_src = File.join(
      plugin_ios,
      'llama.xcframework',
      'ios-arm64',
      'llama.framework',
      'Headers'
    )
  end
  return unless File.directory?(headers_src)

  include_dir = File.join(plugin_root, 'llama.cpp', 'include')
  ggml_include_dir = File.join(plugin_root, 'llama.cpp', 'ggml', 'include')
  FileUtils.mkdir_p(include_dir)
  FileUtils.mkdir_p(ggml_include_dir)

  Dir.children(headers_src).each do |name|
    src = File.join(headers_src, name)
    next unless File.file?(src)

    if name.start_with?('ggml')
      # llama.h uses #include "ggml.h"; with use_frameworks! Xcode hmaps do not
      # fall back to HEADER_SEARCH_PATHS, so ggml headers must live beside llama.h.
      FileUtils.cp(src, File.join(ggml_include_dir, name))
      FileUtils.cp(src, File.join(include_dir, name))
    else
      FileUtils.cp(src, File.join(include_dir, name))
    end
  end
end

# ios_libs are device-only arm64; link the bundled xcframework for simulator + device.
# Must run before flutter_install_all_ios_pods — CocoaPods loads the local spec during
# dependency resolution, so pre_install is too late on a clean pod install.
def patch_flutter_llama_podspec!
  podspec_path = File.expand_path(
    File.join('.symlinks', 'plugins', 'flutter_llama', 'ios', 'flutter_llama.podspec'),
    __dir__
  )
  return unless File.exist?(podspec_path)

  content = File.read(podspec_path)
  return if content.include?('PATCHED_FOR_CLEARHEAR')

  unless content.sub!(
    "  s.vendored_libraries = 'ios_libs/*.a'\n",
    "  # PATCHED_FOR_CLEARHEAR\n  s.vendored_frameworks = 'llama.xcframework'\n"
  )
    raise <<~MSG
      flutter_llama podspec patch failed: vendored_libraries substitution did not apply.
      Expected: s.vendored_libraries = 'ios_libs/*.a'
      File: #{podspec_path}
    MSG
  end

  unless content.gsub!(
    /'OTHER_LDFLAGS' => '\$\(inherited\).*libggml-blas\.a"'/,
    "'OTHER_LDFLAGS' => '$(inherited)'"
  )
    raise <<~MSG
      flutter_llama podspec patch failed: OTHER_LDFLAGS substitution did not apply.
      File: #{podspec_path}
    MSG
  end

  File.write(podspec_path, content)
end

# ---------------------------------------------------------------------------
# Fix: flutter_llama bridge crashes on iOS because ggml_backend_load_all()
# tries to dlopen GPU backends (Metal/CUDA dylibs) which isn't allowed on iOS.
# Wrap it with #if !TARGET_OS_IOS since the model runs CPU-only (n_gpu_layers=0).
# ---------------------------------------------------------------------------
def patch_llama_bridge_ios!
  plugin_root = File.expand_path(File.join('.symlinks', 'plugins', 'flutter_llama'), __dir__)
  file_path = File.join(plugin_root, 'ios', 'Classes', 'llama_cpp_bridge.mm')
  return unless File.exist?(file_path)

  content = File.read(file_path)
  return if content.include?('PATCHED_FOR_CLEARHEAR_LLAMA')

  old = '    ggml_backend_load_all();'
  new = '    // ggml_backend_load_all(); // PATCHED_FOR_CLEARHEAR_LLAMA -- iOS forbids dlopen of GPU backends'

  unless content.sub!(old, new)
    raise <<~MSG
      llama_cpp_bridge.mm patch failed: ggml_backend_load_all() line not found.
      File: #{file_path}
    MSG
  end

  File.write(file_path, content)
  puts '[ClearHear] Patched llama_cpp_bridge.mm -- disabled GPU backend dlopen on iOS'
end

# ---------------------------------------------------------------------------
# Fix: Swift @_silgen_name with String -> const char* can produce invalid
# pointers on ARM64. Use withCString for explicit C-string bridging to prevent
# EXC_BAD_ACCESS crashes during model loading / generation.
# ---------------------------------------------------------------------------
def patch_flutter_llama_swift_string_bridge!
  plugin_root = File.expand_path(File.join('.symlinks', 'plugins', 'flutter_llama'), __dir__)
  file_path = File.join(plugin_root, 'ios', 'Classes', 'FlutterLlamaPlugin.swift')
  return unless File.exist?(file_path)

  content = File.read(file_path)
  decl_patched = false

  # ------------------------------------------------------------------
  # Step 1: ALWAYS fix @_silgen_name declarations
  # String → UnsafePointer<CChar>! so the C function receives a real
  # pointer, not the internal bytes of a Swift String struct.
  # This runs even if the marker is already present, because earlier
  # versions of this patch only fixed call sites, not declarations.
  # ------------------------------------------------------------------
  decl_patched = true if content.sub!('    _ modelPath: String,', '    _ modelPath: UnsafePointer<CChar>!,')
  decl_patched = true if content.sub!('    _ prompt: String,', '    _ prompt: UnsafePointer<CChar>!,')
  decl_patched = true if content.sub!('    _ prompt: String,', '    _ prompt: UnsafePointer<CChar>!,')

  if decl_patched
    File.write(file_path, content)
    puts '[ClearHear] FlutterLlamaPlugin.swift — fixed String → UnsafePointer<CChar> in declarations'
  end

  # ------------------------------------------------------------------
  # Step 2: wrap call sites with withCString (only if not already done)
  # ------------------------------------------------------------------
  return if content.include?('PATCHED_FOR_CLEARHEAR_SWIFT_STRING')

  marker_line = '// PATCHED_FOR_CLEARHEAR_SWIFT_STRING -- withCString bridging'
  indent12 = '            '
  indent16 = '                '
  indent20 = '                    '
  nl = "\n"

  # llama_init_model(modelPath, ...)
  old1 = [
    "#{indent12}let success = llama_init_model(",
    "#{indent16}modelPath,",
    "#{indent16}Int32(nThreads),",
    "#{indent16}Int32(nGpuLayers),",
    "#{indent16}Int32(contextSize),",
    "#{indent16}Int32(batchSize),",
    "#{indent16}useGpu,",
    "#{indent16}verbose",
    "#{indent12})",
  ].join(nl)

  new1 = [
    "#{indent12}#{marker_line}",
    "#{indent12}let success = modelPath.withCString { cModelPath in",
    "#{indent16}llama_init_model(",
    "#{indent20}cModelPath,",
    "#{indent20}Int32(nThreads),",
    "#{indent20}Int32(nGpuLayers),",
    "#{indent20}Int32(contextSize),",
    "#{indent20}Int32(batchSize),",
    "#{indent20}useGpu,",
    "#{indent20}verbose",
    "#{indent16})",
    "#{indent12}}",
  ].join(nl)

  unless content.sub!(old1, new1)
    raise "llama_init_model call-site patch failed in #{file_path}"
  end

  # llama_generate(prompt, ...)
  old2 = [
    "#{indent12}let success = llama_generate(",
    "#{indent16}prompt,",
    "#{indent16}Float(temperature),",
    "#{indent16}Float(topP),",
    "#{indent16}Int32(topK),",
    "#{indent16}Int32(maxTokens),",
    "#{indent16}Float(repeatPenalty),",
    "#{indent16}&outputBuffer,",
    "#{indent16}Int32(outputBuffer.count),",
    "#{indent16}&tokensGenerated",
    "#{indent12})",
  ].join(nl)

  new2 = [
    "#{indent12}let success = prompt.withCString { cPrompt in",
    "#{indent16}llama_generate(",
    "#{indent20}cPrompt,",
    "#{indent20}Float(temperature),",
    "#{indent20}Float(topP),",
    "#{indent20}Int32(topK),",
    "#{indent20}Int32(maxTokens),",
    "#{indent20}Float(repeatPenalty),",
    "#{indent20}&outputBuffer,",
    "#{indent20}Int32(outputBuffer.count),",
    "#{indent20}&tokensGenerated",
    "#{indent16})",
    "#{indent12}}",
  ].join(nl)

  unless content.sub!(old2, new2)
    raise "llama_generate call-site patch failed in #{file_path}"
  end

  # llama_generate_stream_init(prompt, ...)
  old3 = [
    "#{indent12}llama_generate_stream_init(",
    "#{indent16}prompt,",
    "#{indent16}Float(temperature),",
    "#{indent16}Float(topP),",
    "#{indent16}Int32(topK),",
    "#{indent16}Int32(maxTokens),",
    "#{indent16}Float(repeatPenalty)",
    "#{indent12})",
  ].join(nl)

  new3 = [
    "#{indent12}prompt.withCString { cPrompt in",
    "#{indent16}llama_generate_stream_init(",
    "#{indent20}cPrompt,",
    "#{indent20}Float(temperature),",
    "#{indent20}Float(topP),",
    "#{indent20}Int32(topK),",
    "#{indent20}Int32(maxTokens),",
    "#{indent20}Float(repeatPenalty)",
    "#{indent16})",
    "#{indent12}}",
  ].join(nl)

  unless content.sub!(old3, new3)
    raise "llama_generate_stream_init call-site patch failed in #{file_path}"
  end

  File.write(file_path, content)
  puts '[ClearHear] Patched FlutterLlamaPlugin.swift — UnsafePointer<CChar> + withCString bridging'
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# ---------------------------------------------------------------------------
# Fix: audio_waveforms iOS bytes-stream captures mic at hardware sample
# rate (~48 kHz) but the on-device ASR model needs exactly 16 kHz.
# V3: tap input at hardware format, resample each buffer via AVAudioConverter.
# ---------------------------------------------------------------------------
def patch_audio_waveforms_ios_sample_rate!
  plugin_root = File.expand_path(File.join('.symlinks', 'plugins', 'audio_waveforms'), __dir__)
  file_path = File.join(plugin_root, 'ios', 'Classes', 'RecorderBytesStreamEngine.swift')
  return unless File.exist?(file_path)

  content = File.read(file_path)
  return if content.include?('PATCHED_FOR_CLEARHEAR_SAMPLE_RATE_V3')

  patched = <<~'SWIFT'
//
//  RecorderBytesStreamHandler.swift
//  audio_waveforms
//
//  Created by Ujas Majithiya on 10/04/25.
//
//  PATCHED_FOR_CLEARHEAR_SAMPLE_RATE_V3: taps the input node at hardware
//  format, then uses AVAudioConverter to resample each buffer down to
//  the requested sampleRate so on-device ASR models receive 16 kHz audio.

import Foundation
import AVFAudio
import Accelerate

class RecorderBytesStreamEngine {
    private var audioEngine = AVAudioEngine()
    private var flutterChannel: FlutterMethodChannel
    private var paused: Bool = false
    private var totalFrames: AVAudioFramePosition = 0
    private var converter: AVAudioConverter?
    private var outputFormat: AVAudioFormat?

    init(channel: FlutterMethodChannel) {
        flutterChannel = channel
    }

    func attach(result: @escaping FlutterResult, sampleRate: Int) {
        let inputNode = audioEngine.inputNode
        let hwFormat = inputNode.outputFormat(forBus: 0)

        guard let outFmt = AVAudioFormat(
            commonFormat: .pcmFormatFloat32,
            sampleRate: Double(sampleRate),
            channels: 1,
            interleaved: false
        ) else {
            result(FlutterError(code: Constants.audioWaveforms, message: "Failed to create output audio format", details: nil))
            return
        }
        outputFormat = outFmt

        guard let conv = AVAudioConverter(from: hwFormat, to: outFmt) else {
            result(FlutterError(code: Constants.audioWaveforms, message: "Failed to create audio converter", details: nil))
            return
        }
        converter = conv

        inputNode.installTap(onBus: 0, bufferSize: 1024, format: nil) { (buffer, time) in
            if self.paused {
                return
            }
            let workBuffer = self.resampleIfNeeded(buffer)
            guard let workBuffer else { return }

            if let (convertedBytes, normalizedRms) = self.convertToFlutterType(workBuffer) {
                self.totalFrames += AVAudioFramePosition(workBuffer.frameLength)
                let effectiveSampleRate = workBuffer.format.sampleRate > 0 ? workBuffer.format.sampleRate : Double(sampleRate)
                let duration = Double(self.totalFrames) / effectiveSampleRate
                let milliseconds = Int(duration * 1000)
                self.sendToFlutter(
                    convertedBytes,
                    normalizedRms: normalizedRms,
                    milliSeconds: milliseconds
                )
            }
        }
        do {
            try audioEngine.start()
        } catch {
           result(FlutterError(code: Constants.audioWaveforms, message: "Error starting Audio Engine", details: error.localizedDescription))
        }
    }

    func togglePause() {
        paused = !paused
    }

    func detach() {
        totalFrames = 0
        converter = nil
        outputFormat = nil
        audioEngine.inputNode.removeTap(onBus: 0)
        audioEngine.stop()
    }

    private func resampleIfNeeded(_ buffer: AVAudioPCMBuffer) -> AVAudioPCMBuffer? {
        guard let converter, let outFmt = outputFormat else { return nil }

        if buffer.format.sampleRate == outFmt.sampleRate { return buffer }

        let ratio = outFmt.sampleRate / buffer.format.sampleRate
        let outCapacity = AVAudioFrameCount(Double(buffer.frameLength) * ratio + 1)
        guard let outBuf = AVAudioPCMBuffer(pcmFormat: outFmt, frameCapacity: outCapacity) else {
            return nil
        }

        var consumed = false
        var error: NSError?
        let inputBlock: AVAudioConverterInputBlock = { _ /* inNumPackets */, outStatus in
            if consumed {
                outStatus.pointee = .noDataNow
                return nil
            }
            consumed = true
            outStatus.pointee = .haveData
            return buffer
        }

        converter.convert(to: outBuf, error: &error, withInputFrom: inputBlock)

        if let error {
            print("[RecorderBytesStreamEngine] converter error: \(error)")
            return nil
        }

        return outBuf
    }

    private func convertToFlutterType(_ buffer: AVAudioPCMBuffer) -> (FlutterStandardTypedData, Double)? {
        guard let channelData = buffer.floatChannelData?[0] else { return nil }
        let frameLength = Int(buffer.frameLength)

        // Convert Float32 buffer to UInt8 (byte array)
        var audioSamples = [Float32](repeating: 0.0, count: frameLength)
        var sumOfSquares: Float = 0.0

        for i in 0..<frameLength {
            audioSamples[i] = channelData[i]
            sumOfSquares += channelData[i] * channelData[i]
        }

        // Calculate RMS
        var rms: Float = 0.0
        vDSP_rmsqv(
            audioSamples, 1, &rms,
            vDSP_Length(frameLength)
        )

        // Normalize RMS to 0-1 range (assuming max amplitude is 1.0 for Float32)
        let normalizedRms = Double(min(rms, 1.0))

        let byteBuffer = audioSamples.withUnsafeBufferPointer { bufferPointer in
            return Data(buffer: bufferPointer)
        }
        let convertedBuffer = FlutterStandardTypedData(bytes: byteBuffer)
        return (convertedBuffer, normalizedRms)

    }

    private func sendToFlutter(_ buffer: FlutterStandardTypedData, normalizedRms: Double, milliSeconds: Int) {
        DispatchQueue.main.async { [weak self] in
            guard let self else { return }
            flutterChannel.invokeMethod(Constants.onAudioChunk, arguments: [
                Constants.bytes: buffer,
                Constants.normalisedRms: normalizedRms,
                Constants.recordedDuration: milliSeconds,
            ])
        }
    }
}
  SWIFT

  File.write(file_path, patched)
  puts '[ClearHear] Patched audio_waveforms iOS bytes-stream with AVAudioConverter resampling'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

patch_flutter_llama_podspec!

pre_install do |_installer|
  patch_flutter_llama_headers!
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  patch_llama_bridge_ios!
  patch_flutter_llama_swift_string_bridge!
  patch_audio_waveforms_ios_sample_rate!
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  patch_flutter_llama_headers!
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'

      if target.name == 'flutter_llama'
        flags = config.build_settings['OTHER_LDFLAGS'] || '$(inherited)'
        flags = [flags].flatten.join(' ')
        unless flags.include?('-framework llama')
          config.build_settings['OTHER_LDFLAGS'] = "#{flags} -framework llama"
        end
      end
    end
  end
end
